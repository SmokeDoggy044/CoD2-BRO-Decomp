{
  "version": 6,
  "configurePresets": [
    {
      "name": "linux-loader",
      "displayName": "Linux 32-bit with the route-B loader",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-loader",
      "toolchainFile": "${sourceDir}/cmake/toolchains/linux-i686.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-loader-release",
      "inherits": "linux-loader",
      "displayName": "Linux 32-bit loader, optimized, for the player release",
      "binaryDir": "${sourceDir}/build/linux-loader-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "sniper-release",
      "displayName": "Player release inside the Steam Runtime sniper SDK (packaging/sniper/build.sh)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/sniper/release",
      "toolchainFile": "${sourceDir}/cmake/toolchains/sniper-i686.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_PREFIX_PATH": "${sourceDir}/build/sniper/deps",
        "COD_BRO_RELEASE_DEPS": "${sourceDir}/build/sniper/deps"
      },
      "environment": {
        "PKG_CONFIG_PATH": "${sourceDir}/build/sniper/deps/lib/pkgconfig"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux",
      "displayName": "Linux native (portable code only)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "windows",
      "displayName": "Windows (portable code only)",
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/build/windows",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-loader",
      "configurePreset": "linux-loader"
    },
    {
      "name": "linux-loader-release",
      "configurePreset": "linux-loader-release"
    },
    {
      "name": "sniper-release",
      "configurePreset": "sniper-release"
    },
    {
      "name": "linux",
      "configurePreset": "linux"
    },
    {
      "name": "windows",
      "configurePreset": "windows",
      "configuration": "Debug"
    }
  ],
  "testPresets": [
    {
      "name": "linux-loader",
      "configurePreset": "linux-loader",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-loader-release",
      "configurePreset": "linux-loader-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "sniper-release",
      "configurePreset": "sniper-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux",
      "configurePreset": "linux",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows",
      "configurePreset": "windows",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ],
  "packagePresets": [
    {
      "name": "linux-loader-release",
      "configurePreset": "linux-loader-release",
      "generators": [
        "TGZ"
      ]
    },
    {
      "name": "sniper-release",
      "configurePreset": "sniper-release",
      "generators": [
        "TGZ"
      ]
    }
  ]
}
