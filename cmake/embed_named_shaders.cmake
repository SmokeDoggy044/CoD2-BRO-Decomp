# Writes OUTPUT, a C++ table of compiled shaders by file name (src/render/post_shaders.h):
# cmake -DOUTPUT=file.cpp -DINPUTS="a.d3dbc;b.d3dbc" [-DHEADER=x.h -DFUNCTION=name] -P embed_named_shaders.cmake
# (default post_shaders.h / post_shader; tests use their own).
if(NOT HEADER)
    set(HEADER post_shaders.h)
endif()
if(NOT FUNCTION)
    set(FUNCTION post_shader)
endif()
set(arrays "")
set(rows "")
foreach(input ${INPUTS})
    get_filename_component(name ${input} NAME_WE)
    file(READ ${input} hex HEX)
    string(LENGTH "${hex}" digits)
    math(EXPR bytes "${digits} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
    string(APPEND arrays "alignas(4) const unsigned char k_${name}[] = {${hex}};\n")
    # The SPIR-V beside it (same name, .spv).
    get_filename_component(dir ${input} DIRECTORY)
    file(READ ${dir}/${name}.spv hex HEX)
    string(LENGTH "${hex}" digits)
    math(EXPR spirv_bytes "${digits} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
    string(APPEND arrays "alignas(4) const unsigned char k_${name}_spv[] = {${hex}};\n")
    string(APPEND rows "    {\"${name}\", k_${name}, ${bytes}, k_${name}_spv, ${spirv_bytes}},\n")
endforeach()
file(WRITE ${OUTPUT}.tmp "// Generated by cmake/embed_named_shaders.cmake; do not edit.
#include \"${HEADER}\"

#include <cstring>

namespace render {
namespace {
${arrays}
const NamedShader kShaders[] = {
${rows}};

}  // namespace

const NamedShader* ${FUNCTION}(const char* name) {
    for (const NamedShader& s : kShaders)
        if (std::strcmp(s.name, name) == 0) return &s;
    return nullptr;
}

}  // namespace render
")
file(COPY_FILE ${OUTPUT}.tmp ${OUTPUT} ONLY_IF_DIFFERENT)
