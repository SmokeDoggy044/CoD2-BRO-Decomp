# Writes OUTPUT, a C++ table of the compiled title shaders (render/gfx_d3d9.cpp's
# create_title_shader): cmake -DOUTPUT=file.cpp -DINPUTS="a.d3dbc;b.d3dbc" -P embed_shaders.cmake
# Each input's name is vs_KEY or ps_KEY (KEY: 8 hex digits).
set(arrays "")
set(rows "")
foreach(input ${INPUTS})
    get_filename_component(name ${input} NAME_WE)
    string(SUBSTRING ${name} 0 1 stage)
    string(SUBSTRING ${name} 3 8 key)
    file(READ ${input} hex HEX)
    string(LENGTH "${hex}" digits)
    math(EXPR bytes "${digits} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
    string(APPEND arrays "alignas(4) const unsigned char k_${name}[] = {${hex}};\n")
    string(APPEND rows "    {'${stage}', 0x${key}u, k_${name}, ${bytes}},\n")
endforeach()
file(WRITE ${OUTPUT}.tmp "// Generated by cmake/embed_shaders.cmake from render/shaders; do not edit.
#include \"title_shaders.h\"

namespace render {
namespace {
${arrays}}  // namespace

const TitleShader kTitleShaders[] = {
${rows}};
const unsigned kTitleShaderCount = sizeof(kTitleShaders) / sizeof(kTitleShaders[0]);

}  // namespace render
")
file(COPY_FILE ${OUTPUT}.tmp ${OUTPUT} ONLY_IF_DIFFERENT)
