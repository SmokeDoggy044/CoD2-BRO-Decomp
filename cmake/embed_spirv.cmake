# Writes OUTPUT, a C++ table of SPIR-V shaders by file name (src/render/vk/vk_shaders.h):
# cmake -DOUTPUT=file.cpp -DINPUTS="blit.vert.spv;blit.frag.spv" -P embed_spirv.cmake
set(arrays "")
set(rows "")
foreach(input ${INPUTS})
    get_filename_component(file ${input} NAME)
    string(REGEX REPLACE "\\.spv$" "" name "${file}")
    string(MAKE_C_IDENTIFIER "${name}" id)
    file(READ ${input} hex HEX)
    string(LENGTH "${hex}" digits)
    math(EXPR bytes "${digits} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
    string(APPEND arrays "alignas(4) const unsigned char k_${id}[] = {${hex}};\n")
    string(APPEND rows "    {\"${name}\", reinterpret_cast<const uint32_t*>(k_${id}), ${bytes}},\n")
endforeach()
file(WRITE ${OUTPUT}.tmp "// Generated by cmake/embed_spirv.cmake; do not edit.
#include \"vk_shaders.h\"

#include <cstring>

namespace render::vk {
namespace {
${arrays}
const SpirvShader kShaders[] = {
${rows}};

}  // namespace

const SpirvShader* spirv_shader(const char* name) {
    for (const SpirvShader& s : kShaders)
        if (std::strcmp(s.name, name) == 0) return &s;
    return nullptr;
}

}  // namespace render::vk
")
file(COPY_FILE ${OUTPUT}.tmp ${OUTPUT} ONLY_IF_DIFFERENT)
